# Lock In environment. Every variable is optional: with this file empty the
# app runs fully on one device (data in localStorage, photos in IndexedDB).
# Copy to .env.local and fill in what you have.

# ---------- Passcode ----------
# Digits only, 4 to 8 of them. When set, the passcode is checked on the server
# and kept in an httpOnly cookie for 30 days. When unset, each device asks you
# to create its own 4 digit passcode on first run.
# Required when Supabase is on.
LOCKIN_PASSCODE=

# ---------- Supabase (database and photos) ----------
# Setting the URL switches data from the device to Supabase. The service role
# key stays on the server: the browser only ever talks to /api/db.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket for photos. The migration creates "photos".
SUPABASE_PHOTO_BUCKET=photos

# ---------- Claude API (coach, meal and earnings photo reading) ----------
# Without it the AI routes answer with rule-based fallbacks.
ANTHROPIC_API_KEY=
# Optional. The model all three AI routes use. Defaults to claude-sonnet-5-5
# (set in src/lib/ai/server.ts). It must accept images.
ANTHROPIC_MODEL=

# ---------- Instacart (order the grocery list) ----------
# A key from the Instacart Developer Platform. With it the grocery list gets
# an "Order on Instacart" button that opens the list as a shoppable page.
# Without it the list can be copied or shared, and nothing else changes.
INSTACART_API_KEY=
# Optional. Defaults to https://connect.instacart.com (production). A
# development key needs https://connect.dev.instacart.tools
INSTACART_API_URL=

# ---------- Google Calendar (two-way sync) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For example https://your-app.vercel.app/api/calendar/callback
GOOGLE_REDIRECT_URI=

# ---------- Web push (reminders) ----------
# Make a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push service, for example mailto:you@example.com
VAPID_SUBJECT=
# Shared secret for the scheduled job that sends reminders. Any long random
# string, for example: openssl rand -hex 32
# The job is GET /api/reminders/cron with "Authorization: Bearer <CRON_SECRET>"
# and has to be called every 5 minutes. See README, Reminders.
CRON_SECRET=
